  "eventPatterns": {
    "request": {
      "description": "Client sends request to server",
      "format": "socket.emit(eventName, payload, callback)",
      "callback": {
        "success": {
          "ok": true,
          "data": "any"
        },
        "error": {
          "ok": false,
          "error": "string"
        }
      }
    },
    "broadcast": {
      "description": "Server broadcasts to all clients",
      "format": "io.emit(eventName, payload) or socket.broadcast.emit(eventName, payload)",
      "listening": "socket.on(eventName, handler)"
    }
  },
  "notes": {
    "broadcasting": "When handling mutating operations (create/update/delete), the backend should broadcast the change to all connected clients using the corresponding broadcast event",
    "responseFormat": "All request handlers should respond using the callback with {ok: boolean, ...data} format",
    "authentication": "All socket connections should be authenticated. The frontend uses withCredentials: true",
    "cors": "The backend should configure CORS to allow the frontend origin",
    "totalEvents": "143+ socket event listeners configured in SocketManager.ts",
    "totalEmitters": "707+ emitter functions in emitter.ts"
  }
}
