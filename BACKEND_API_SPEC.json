  "authentication": {
    "required": true,
    "method": "token",
    "events": {
      "auth:login": {
        "description": "User login",
        "request": {
          "email": "string",
          "password": "string"
        },
        "response": {
          "ok": "boolean",
          "user": "User",
          "token": "string"
        }
      },
      "auth:register": {
        "description": "User registration",
        "request": {
          "name": "string",
          "email": "string",
          "password": "string"
        },
        "response": {
          "ok": "boolean",
          "user": "User",
          "token": "string"
        }
      },
      "auth:logout": {
        "description": "User logout",
        "request": {},
        "response": {
          "ok": "boolean"
        }
      }
    }
  },
